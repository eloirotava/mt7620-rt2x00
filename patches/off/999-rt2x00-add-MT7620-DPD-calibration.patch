+static void rt2800_dpd_calibration_rt6352(struct rt2x00_dev *rt2x00dev)
+{
+	struct rt6352_dpd_state st = { };
+	bool two = rt2x00dev->default_ant.tx_chain_num > 1;
+	int ant0, ant1 = 0, i;
+	u8 bbp;
+
+	rt2800_dpd_prepare_null_frame(rt2x00dev);
+
+	ant0 = rt2800_dpd_calibration_chain(rt2x00dev, &st, 0);
+	if (two)
+		ant1 = rt2800_dpd_calibration_chain(rt2x00dev, &st, 1);
+
+	if (ant0 != 2 && ant1 != 2)
+		return;
+
+	/* no DPD compensation while the LUTs are post-processed */
+	bbp = rt2800_bbp_read(rt2x00dev, 4);
+	rt2800_bbp_write(rt2x00dev, 4, (bbp & ~0x18) | 0x10);
+
+	/* clear the first failed LUT, then LUTs 6-13 */
+	if (!st.tag_ok[0][0])
+		i = 2;
+	else if (!st.tag_ok[0][1])
+		i = 3;
+	else if (!st.tag_ok[1][0])
+		i = 4;
+	else if (!st.tag_ok[1][1])
+		i = 5;
+	else
+		i = 0;
+	if (i) {
+		rt2800_bbp_write(rt2x00dev, 186, i);
+		rt2800_bbp_write(rt2x00dev, 186, i);
+		rt2800_bbp_write(rt2x00dev, 189, 0x0f);
+	}
+	for (i = 6; i <= 13; i++) {
+		rt2800_bbp_write(rt2x00dev, 186, i);
+		rt2800_bbp_write(rt2x00dev, 186, i);
+		rt2800_bbp_write(rt2x00dev, 189, 0x0f);
+	}
+
+	if (rt2800_hw_get_chipver(rt2x00dev) == 1) {
+		rt2800_dpd_am_pm_inversion(rt2x00dev, 0);
+		if (two)
+			rt2800_dpd_am_pm_inversion(rt2x00dev, 1);
+	}
+
+	if (ant0 == 2)
+		rt2800_dpd_am_am_scaling(rt2x00dev, 0);
+	if (two && ant1 == 2)
+		rt2800_dpd_am_am_scaling(rt2x00dev, 1);
+
+	rt2800_bbp_write(rt2x00dev, 4, bbp);
+
+	if (!st.tag_ok[0][0] && !st.tag_ok[0][1] &&
+	    !st.tag_ok[1][0] && !st.tag_ok[1][1]) {
+		rt2800_bbp_write(rt2x00dev, 186, 0x00);
+		rt2800_bbp_write(rt2x00dev, 187, 0x00);
+		rt2800_bbp_write(rt2x00dev, 188, 0x00);
+		rt2x00_info(rt2x00dev, "DPD calibration failed, compensation off\n");
+	} else {
+		/* enable DPD compensation */
+		rt2800_bbp_write(rt2x00dev, 186, 0x00);
+		rt2800_bbp_write(rt2x00dev, 187, 0x04);
+		rt2800_bbp_write(rt2x00dev, 188, 0x1c);
+		rt2800_bbp_write(rt2x00dev, 187, 0x05);
+		rt2800_bbp_write(rt2x00dev, 188, 0x12);
+		rt2800_bbp_write(rt2x00dev, 187, 0x00);
+		rt2800_bbp_write(rt2x00dev, 188, 0xc0);
+		rt2x00_info(rt2x00dev, "DPD calibration done (tx0 %d%d tx1 %d%d)\n",
+			    st.tag_ok[0][0], st.tag_ok[0][1],
+			    st.tag_ok[1][0], st.tag_ok[1][1]);
+	}
+
+	rt2800_bbp_write(rt2x00dev, 21, 0x01);
+	rt2800_bbp_write(rt2x00dev, 21, 0x00);
+}
